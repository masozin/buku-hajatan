rules_version = '2';

// =====================================================================
// Buku Hajatan — Firestore Security Rules (Batch 1, diperbarui Batch 4)
// Tempel SELURUH isi file ini ke: Firebase Console > Firestore Database
// > Rules > Edit rules > Publish.
//
// Prinsip (rancangan teknis §4, Auth Opsi A):
// - Pemilik acara = user email/password; dokumen acara hanya bisa
//   dibuat/diubah/dihapus oleh pemiliknya, dan akun ANONIM tidak boleh
//   membuat acara.
// - Pencatat (Batch 10 — identitas tetap + kunci sesi): dokumen
//   pencatat ber-ID TETAP (bukan UID perangkat). Perangkat yang
//   sedang memegang sesi mendaftarkan pencatatSesi/{uid} dan dokumen
//   pencatatnya menyimpan uidAktif == UID perangkat itu; rules
//   memeriksa keduanya cocok. Masuk memakai nama + PIN pribadi
//   (di dokumen undangan, diperiksa aplikasi); sesi hanya boleh
//   dipegang SATU perangkat — rules menolak merebut sesi orang lain.
// - kodeAcara/{kode}: hanya boleh dibaca SATU dokumen bila kodenya tahu
//   (get), TIDAK boleh di-list — kode adalah kunci pencarian acara,
//   pasangannya PIN di dalam dokumen yang sama.
//
// Batasan yang jujur (sudah dicatat di rancangan):
// - Rules TIDAK bisa menghitung isi sub-collection, jadi aturan
//   "maks 10 amplop per bundel" dijaga aplikasi, bukan di sini.
// - Query daftar (list) untuk undangan & collectionGroup pencatat
//   dibuka untuk pengguna yang sudah masuk; aplikasi yang menyaring
//   tampilannya. Data yang bisa terbaca pihak ketiga lewat celah ini
//   terbatas pada nama pencatat di acara yang ID-nya ia ketahui.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function sudahMasuk() {
      return request.auth != null;
    }

    function bukanAnonim() {
      return sudahMasuk()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function pemilikAcara(acaraId) {
      return sudahMasuk()
        && get(/databases/$(database)/documents/acara/$(acaraId)).data.pemilikId
            == request.auth.uid;
    }

    // --- Kunci sesi pencatat (Batch 10) ---
    function adaSesi(acaraId) {
      return exists(/databases/$(database)/documents/acara/$(acaraId)/pencatatSesi/$(request.auth.uid));
    }

    function sesiSaya(acaraId) {
      return get(/databases/$(database)/documents/acara/$(acaraId)/pencatatSesi/$(request.auth.uid)).data;
    }

    function pencatatSaya(acaraId) {
      return get(/databases/$(database)/documents/acara/$(acaraId)/pencatat/$(sesiSaya(acaraId).pencatatId)).data;
    }

    function idPencatatSaya(acaraId) {
      return sesiSaya(acaraId).pencatatId;
    }

    // Anggota pencatat acara ini = memegang sesi yang sah: dokumen
    // sesi ada, dokumen pencatatnya menunjuk uidAktif == perangkat
    // ini, dan statusnya aktif.
    function pencatatAcara(acaraId) {
      return sudahMasuk() && adaSesi(acaraId)
        && pencatatSaya(acaraId).uidAktif == request.auth.uid
        && pencatatSaya(acaraId).aktif == true;
    }

    // Admin platform (Batch 4): dokumen admin/{uid} ada. Dokumen ini
    // dibuat SEKALI lewat Firebase Console — tidak ada jalan membuat
    // diri sendiri jadi admin dari aplikasi (write dimatikan total).
    function adalahAdmin() {
      return sudahMasuk()
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function pemilikDiblokir(uid) {
      return exists(/databases/$(database)/documents/pemilik/$(uid))
        && get(/databases/$(database)/documents/pemilik/$(uid)).data
            .get('diblokir', false) == true;
    }

    // Koreksi pemilik (Batch 6) hanya pada acara yang sudah selesai.
    function acaraSudahSelesai(acaraId) {
      return get(/databases/$(database)/documents/acara/$(acaraId)).data
          .status == 'selesai';
    }

    // Metode Langsung (Batch 30): acara tanpa bundel — urut
    // amplopnya berjalan terus tanpa batas 10. Acara lama tanpa
    // field metodePencatatan terbaca sebagai bundel.
    function metodeLangsung(acaraId) {
      return get(/databases/$(database)/documents/acara/$(acaraId)).data
          .get('metodePencatatan', 'bundel') == 'langsung';
    }

    // Bundel bebas (Batch 30/32): wadah mengalir per pencatat —
    // di Metode Langsung untuk semua catatannya, dan di acara
    // Metode Bundel khusus untuk entri Mode Buku Tamu (Batch 32:
    // buku tamu tidak memakai bundel). Urutnya berjalan terus.
    function bundelBebas(acaraId, bundelId) {
      return get(/databases/$(database)/documents/acara/$(acaraId)/bundel/$(bundelId)).data
          .get('bebas', false) == true;
    }

    // -------------------------------------------------------------- admin
    match /admin/{uid} {
      // Aplikasi hanya perlu mengecek status adminnya sendiri.
      allow get: if sudahMasuk() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ------------------------------------------------------------ pemilik
    match /pemilik/{uid} {
      allow get: if (sudahMasuk() && request.auth.uid == uid)
        || adalahAdmin();
      // Daftar semua pemilik hanya untuk panel admin.
      allow list: if adalahAdmin();
      // Dibuat oleh pemiliknya sendiri (jalur lama) ATAU dibuatkan
      // admin lewat provisioning (Batch 5).
      allow create: if (sudahMasuk() && request.auth.uid == uid
          && request.resource.data.get('diblokir', false) == false)
        || adalahAdmin();
      // Pemilik mengubah profilnya sendiri ASAL field diblokir tidak
      // berubah (tidak bisa membuka blokirnya sendiri); admin hanya
      // boleh mengubah field diblokir, tidak yang lain.
      allow update: if (sudahMasuk() && request.auth.uid == uid
          && request.resource.data.get('diblokir', false)
              == resource.data.get('diblokir', false))
        || (adalahAdmin()
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['diblokir']));
      allow delete: if sudahMasuk() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------- kodeAcara
    match /kodeAcara/{kode} {
      allow get: if sudahMasuk();
      allow list: if false;
      // Kode gabung selalu dibuat bersama acaranya (Batch 5: oleh
      // admin untuk pemilik tujuan) — gerbang blokirnya memeriksa
      // pemilik TUJUAN, bukan pembuatnya.
      allow create: if bukanAnonim()
        && (request.resource.data.pemilikId == request.auth.uid
            || adalahAdmin())
        && !pemilikDiblokir(request.resource.data.pemilikId);
      allow update, delete: if sudahMasuk()
        && resource.data.pemilikId == request.auth.uid;
    }

    // -------------------------------------------------------------- acara
    match /acara/{acaraId} {
      allow get: if sudahMasuk()
        && (resource.data.pemilikId == request.auth.uid
            || pencatatAcara(acaraId)
            || adalahAdmin());
      // list dipakai query "acara milik saya" (where pemilikId == uid);
      // rules tidak bisa memeriksa isi query, jadi dibuka untuk yang
      // sudah masuk — aplikasi menyaring berdasarkan pemilikId.
      allow list: if sudahMasuk();
      // Sejak Batch 5 acara HANYA dibuat oleh admin (untuk pemilik
      // tujuan yang tidak sedang diblokir); pemilik tidak lagi
      // membuat acaranya sendiri. Acara lama tidak disentuh.
      allow create: if bukanAnonim() && adalahAdmin()
        && !pemilikDiblokir(request.resource.data.pemilikId);
      // Pemilik bebas mengubah. Pencatat BOLEH mengubah, tapi HANYA
      // agregat hitungannya (Batch 2: tiap amplop menaikkan totalAmplop
      // / totalRp / totalBundel dalam batch tulis yang sama) dan HANYA
      // selama acara masih aktif — field lain (pemilik, nama, status,
      // kode gabung, ...) tidak boleh disentuh pencatat.
      allow update: if sudahMasuk()
        && (resource.data.pemilikId == request.auth.uid
            || (pencatatAcara(acaraId)
                && resource.data.status == 'aktif'
                && request.resource.data
                    .diff(resource.data)
                    .changedKeys()
                    .hasOnly([
                      'totalAmplop',
                      'totalRp',
                      'totalBundel',
                      'updatedAt',
                    ])));
      allow delete: if sudahMasuk()
        && resource.data.pemilikId == request.auth.uid;

      // -------------------------------------------------------- pencatat
      match /pencatat/{pencatatId} {
        // Dibaca bebas oleh yang sudah masuk — proses gabung perlu
        // membacanya sebelum sesi terbentuk. Konsekuensi yang sama
        // seperti undangan sejak Batch 1: PIN pribadi (tersimpan di
        // undangan + salinannya di sini) ikut terbaca oleh pengguna
        // masuk yang mengetahui ID acara; pemeriksaan PIN saat
        // gabung dilakukan aplikasi, rules menjaga sesi AKTIF tidak
        // bisa direbut perangkat lain.
        allow get, list: if sudahMasuk();
        // Klaim pertama (Batch 10): dokumen dibuat dengan sesi
        // langsung dipegang pengklaim (uidAktif == UID-nya).
        allow create: if sudahMasuk()
          && request.resource.data.uidAktif == request.auth.uid;
        // Ubah: pemilik bebas. Selain itu hanya bila hasil akhirnya
        // uidAktif == perangkat ini DAN sesi sebelumnya kosong atau
        // memang milik perangkat ini — sesi orang lain TIDAK bisa
        // direbut (PIN pribadi diperiksa aplikasi sebelum ambil sesi).
        allow update: if pemilikAcara(acaraId)
          || (sudahMasuk()
              && request.resource.data.uidAktif == request.auth.uid
              && (resource.data.get('uidAktif', '') == ''
                  || resource.data.uidAktif == request.auth.uid))
          // Pemegang sesi melepas sesinya sendiri saat keluar:
          // uidAktif-nya sendiri yang dihapus.
          || (sudahMasuk()
              && resource.data.uidAktif == request.auth.uid
              && !('uidAktif' in request.resource.data));
        allow delete: if pemilikAcara(acaraId);
      }

      // --------------------------------------------------- pencatatSesi
      // Dokumen sesi perangkat: pencatatSesi/{uid} -> { pencatatId }.
      match /pencatatSesi/{uidSesi} {
        allow get: if pemilikAcara(acaraId)
          || (sudahMasuk() && request.auth.uid == uidSesi);
        allow list: if pemilikAcara(acaraId);
        // Dibuat/diubah saat gabung, selalu di batch yang sama
        // dengan penulisan dokumen pencatatnya. Hanya untuk UID
        // sendiri. Dokumen sesi SENDIRI tidak memberi hak apa pun:
        // pencatatAcara() tetap memeriksa dokumen pencatat yang
        // ditunjuk sedang memegang uidAktif == UID ini, jadi sesi
        // tidak bisa dipalsukan untuk merebut keanggotaan orang
        // lain (perbaikan Batch 10: pemeriksaan silang get() di
        // sini dihapus agar batch klaim tidak bergantung padanya).
        allow create, update: if sudahMasuk()
          && request.auth.uid == uidSesi
          && request.resource.data.pencatatId is string;
        // Dihapus saat keluar (oleh perangkatnya) atau reset sesi /
        // nonaktif (oleh pemilik).
        allow delete: if pemilikAcara(acaraId)
          || (sudahMasuk() && request.auth.uid == uidSesi);
      }

      // ------------------------------------------------- undanganPencatat
      match /undanganPencatat/{undanganId} {
        allow get, list: if sudahMasuk();
        allow create, delete: if pemilikAcara(acaraId);
        // Pemilik bebas mengubah; pencatat hanya boleh mengubah status
        // undangan MENJADI diklaim oleh dirinya sendiri.
        allow update: if pemilikAcara(acaraId)
          || (sudahMasuk()
              && resource.data.status == 'menunggu'
              && request.resource.data.status == 'diklaim'
              && request.resource.data.claimedBy == request.auth.uid);
      }

      // ---------------------------------------------------------- bundel
      // Dipakai sejak Batch 2 (pencatatan hari-H); aturannya ditulis
      // di Batch 1 supaya struktur lengkap sejak awal.
      match /bundel/{bundelId} {
        allow get, list: if pemilikAcara(acaraId) || pencatatAcara(acaraId);
        // Buat: pencatat untuk bundelnya sendiri; ATAU pemilik
        // membuat BUNDEL KHUSUS PEMILIK (Batch 20 — prefix 'PM',
        // pencatatId = UID pemilik) untuk koreksi setelah acara
        // selesai.
        allow create: if (pencatatAcara(acaraId)
              && request.resource.data.pencatatId == idPencatatSaya(acaraId))
          || (pemilikAcara(acaraId) && acaraSudahSelesai(acaraId)
              && request.resource.data.pencatatId == request.auth.uid
              && request.resource.data.prefix == 'PM');
        // Pemilik menyentuh bundel hanya untuk koreksi SETELAH acara
        // selesai (Batch 6); pencatat seperti biasa selama aktif.
        allow update: if (pemilikAcara(acaraId)
              && acaraSudahSelesai(acaraId))
          || (pencatatAcara(acaraId)
              && resource.data.pencatatId == idPencatatSaya(acaraId));
        allow delete: if pemilikAcara(acaraId)
          && acaraSudahSelesai(acaraId);

        // -------------------------------------------------------- amplop
        match /amplop/{amplopId} {
          allow get, list: if pemilikAcara(acaraId)
            || pencatatAcara(acaraId);
          // Buat: pencatat selama acara berjalan (createdBy = ID
          // tetap pencatatnya, Batch 10); ATAU pemilik untuk koreksi
          // setelah acara selesai (Batch 6, createdBy = UID pemilik).
          // Batasan field sama untuk keduanya.
          allow create: if ((pencatatAcara(acaraId)
                && request.resource.data.createdBy == idPencatatSaya(acaraId))
              || (pemilikAcara(acaraId) && acaraSudahSelesai(acaraId)
                && request.resource.data.createdBy == request.auth.uid))
            && request.resource.data.nominal >= 0
            && request.resource.data.jenis in ['normal', 'kosong', 'tanpa_nama']
            && request.resource.data.urut >= 1
            // Batch 30/32: batas 10 hanya untuk bundel biasa;
            // bundel bebas (Metode Langsung & Buku Tamu) urutnya
            // berjalan terus.
            && (request.resource.data.urut <= 10
                || metodeLangsung(acaraId)
                || bundelBebas(acaraId, bundelId));
          // Ubah: pemilik setelah acara selesai (koreksi Batch 6),
          // ATAU pencatat penginputnya sendiri selama acara aktif
          // (Batch 8 — hanya field isi yang boleh berubah, bukan
          // urut/createdBy). Hapus tetap khusus pemilik pasca-selesai.
          // Batch 29: field 'rt'/'rw' (Batch 25) ikut diizinkan —
          // sebelumnya tertinggal dari daftar ini, sehingga ubah
          // pencatat yang menyentuh RT/RW (atau pengunjung lama
          // yang belum punya field itu) ditolak permission-denied.
          allow update: if (pemilikAcara(acaraId)
              && acaraSudahSelesai(acaraId))
            || (pencatatAcara(acaraId)
                && resource.data.createdBy == idPencatatSaya(acaraId)
                && !acaraSudahSelesai(acaraId)
                && request.resource.data
                    .diff(resource.data)
                    .changedKeys()
                    .hasOnly([
                      'nama', 'alamat', 'dusun', 'keterangan',
                      'nominal', 'jenis', 'rt', 'rw',
                      // Batch 32: Mode Hitung pencatat menandai
                      // entri Buku Tamu-nya sudah dihitung.
                      'dihitung',
                    ]));
          allow delete: if pemilikAcara(acaraId)
            && acaraSudahSelesai(acaraId);
        }
      }
    }

    // ------------------------------------------- collectionGroup pencatat
    // Untuk daftar "acara yang saya ikuti": query collectionGroup ke
    // semua sub-koleksi pencatat berdasarkan sesi aktif (uidAktif;
    // data lama: userId — keduanya diterima selama masa peralihan).
    match /{path=**}/pencatat/{pencatatId} {
      allow get, list: if sudahMasuk()
        && (resource.data.get('uidAktif', '') == request.auth.uid
            || resource.data.get('userId', '') == request.auth.uid);
    }
  }
}
